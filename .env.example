# Copy to .env (git-ignored). No real provider keys are needed for S0.
CAMPUS_DATABASE_URL=postgresql+psycopg://campus_app:campus_app_dev@localhost:5433/campus
CAMPUS_MIGRATION_DATABASE_URL=postgresql+psycopg://campus_owner:campus_owner_dev@localhost:5433/campus
CAMPUS_TEST_DATABASE_URL=postgresql+psycopg://campus_owner:campus_owner_dev@localhost:5433/campus_test
CAMPUS_CAPABILITY_LEVEL=development_mock
CAMPUS_COOKIE_SECURE=false
CAMPUS_ADMIN_PASSWORD=
# S1: approved adapters (comma separated). Only listed adapters are loaded; anything else is ADAPTER_NOT_APPROVED.
CAMPUS_APPROVED_ADAPTERS=mock
# Provider secrets resolve from secret://providers/<name> -> CAMPUS_SECRET_PROVIDERS_<NAME>. Never commit values.
# CAMPUS_SECRET_PROVIDERS_ANTHROPIC=
# CAMPUS_SECRET_PROVIDERS_OPENAI=
# Live tests (cost money): CAMPUS_LIVE_TESTS=1 plus the two native model ids from discovery.
# CAMPUS_LIVE_ANTHROPIC_MODEL=
# CAMPUS_LIVE_OPENAI_MODEL=
