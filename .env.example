# Copy to .env (git-ignored). No real provider keys are needed for S0.
CAMPUS_DATABASE_URL=postgresql+psycopg://campus_app:campus_app_dev@localhost:5433/campus
CAMPUS_MIGRATION_DATABASE_URL=postgresql+psycopg://campus_owner:campus_owner_dev@localhost:5433/campus
CAMPUS_TEST_DATABASE_URL=postgresql+psycopg://campus_owner:campus_owner_dev@localhost:5433/campus_test
CAMPUS_CAPABILITY_LEVEL=development_mock
CAMPUS_COOKIE_SECURE=false
CAMPUS_ADMIN_PASSWORD=
# S1: approved adapters (comma separated). Only listed adapters are loaded; anything else is ADAPTER_NOT_APPROVED.
CAMPUS_APPROVED_ADAPTERS=mock
# Provider secrets resolve from secret://providers/<name> -> CAMPUS_SECRET_PROVIDERS_<NAME>. Never commit values.
# CAMPUS_SECRET_PROVIDERS_ANTHROPIC=
# CAMPUS_SECRET_PROVIDERS_OPENAI=
# Live tests (cost money): CAMPUS_LIVE_TESTS=1 plus the two native model ids from discovery.
# CAMPUS_LIVE_ANTHROPIC_MODEL=
# CAMPUS_LIVE_OPENAI_MODEL=
# S2: Temporal (docker compose up -d temporal). Worker: python -m campus_workers.worker [queue]
CAMPUS_TEMPORAL_ADDRESS=localhost:7233
CAMPUS_TEMPORAL_NAMESPACE=default
# S1.1: hosts allowed for openai_compatible endpoints (https only). Official adapters are bound to their official endpoint.
CAMPUS_APPROVED_API_HOSTS=
# S4: protected evaluation material through its own role (schema vault). The application role cannot read it.
CAMPUS_VAULT_DATABASE_URL=postgresql+psycopg://campus_vault:campus_vault_dev@localhost:5433/campus
# S4: sandbox path. none = capability off; mock = fixtures only (development_mock); docker = hardened containers, needs an acceptance.
CAMPUS_SANDBOX_RUNNER=none
# Digest-pinned image for the docker runner, e.g. python@sha256:<digest> (docker inspect --format '{{index .RepoDigests 0}}' python:3.12-slim)
CAMPUS_SANDBOX_IMAGE=
CAMPUS_SANDBOX_WORKROOT=var/sandbox
# Sandbox tests run real containers: CAMPUS_TEST_SANDBOX=1 and CAMPUS_TEST_SANDBOX_IMAGE=<digest-pinned image>
