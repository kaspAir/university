{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phronesis.invalid/contracts/search_plan.schema.json",
  "title": "search_plan",
  "description": "Repository addition (14.10.2026): what a model derives from the mandate for the campus's own source discovery: sub-questions, search queries bound to them, and what public search cannot answer. The core runs the searches; the plan carries no authority and reads no source.",
  "type": "object",
  "properties": {
    "sub_questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "basis": {"enum": ["question_space", "knowledge_goal", "method_frame", "gap", "counter_evidence"]}
        },
        "required": ["id", "question", "basis"],
        "additionalProperties": false
      }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "minLength": 1},
          "sub_question_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "language": {"type": "string", "minLength": 2},
          "kind": {"enum": ["evidence", "counter_evidence", "primary_source", "official_source", "practice"]},
          "rationale": {"type": "string", "minLength": 1}
        },
        "required": ["query", "sub_question_ids", "language", "kind", "rationale"],
        "additionalProperties": false
      }
    },
    "not_searchable": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "required": ["sub_questions", "queries", "not_searchable"],
  "additionalProperties": false
}
