{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phronesis.invalid/contracts/review_report.schema.json",
  "title": "review_report",
  "description": "Repository addition (S1), not part of the package's six design schemas. Output contract of the distinct-model first review (Art. 17-18). The reviewer judges the frozen artifact; the verdict is a model opinion, not a truth bit.",
  "type": "object",
  "properties": {
    "verdict": {
      "enum": ["no_objection", "objections", "cannot_assess"]
    },
    "checked_aspects": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subject": {"type": "string", "minLength": 1},
          "argument": {"type": "string", "minLength": 1},
          "severity": {"enum": ["minor", "major", "blocking"]},
          "scope": {"type": "string", "minLength": 1}
        },
        "required": ["subject", "argument", "severity", "scope"],
        "additionalProperties": false
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "required": ["verdict", "checked_aspects", "findings", "uncertainties"],
  "additionalProperties": false
}
